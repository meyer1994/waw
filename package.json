{
  "name": "waw",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "types": "openapi-typescript openapi-camara.json -o shared/camara.d.ts && openapi-typescript openapi-senado.json -o shared/senado.d.ts",
    "cf:deploy": "wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts && eslint --fix shared/wrangler.d.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.1",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "d3-force": "^3.0.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "v-network-graph": "^0.9.23",
    "vue": "^3.5.42",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.10.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.131.2"
  },
  "packageManager": "pnpm@11.25.0"
}
